# Samskara environment schema for Varlock.
# Used only by `npm start` (`varlock run -- mastra start`). `npm run dev`,
# `npm run dev:secure` and the Docker image do not read this file; .env.example
# documents the same variables for them.
# Every section is optional: when the vars for a feature are absent, that
# feature is a no-op. A placeholder is a value: the code treats any non-empty
# value as configured.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# ---------------------------------------------------------------------------
# Browser-facing origin
# ---------------------------------------------------------------------------

# The public origin the browser uses to reach the app. This is the single
# source of truth for ALL OAuth callback URLs:
#   - WorkOS:  <MASTRACODE_PUBLIC_URL>/auth/callback
#   - GitHub:  <MASTRACODE_PUBLIC_URL>/auth/github/callback
#   - Linear:  <MASTRACODE_PUBLIC_URL>/auth/linear/callback
# Defaults to http://localhost:4111 (the Factory server, which also serves
# the UI) when unset.
# @public @type=url
MASTRACODE_PUBLIC_URL=
# Public origin Slack/channels must reach for OAuth callbacks and deep links.
# Must be publicly routable (e.g. a tunnel). Falls back to
# MASTRACODE_PUBLIC_URL when unset.
# @public @type=url
MASTRACODE_CHANNELS_PUBLIC_URL=
# Port the server listens on (default 4111). Also used for invitation links
# when MASTRACODE_PUBLIC_URL is unset (src/mastra/auth/better-auth.ts:110).
# @public
PORT=
# Slack request signing secret (Basic Information → App Credentials). This is
# the switch for Slack as a whole: unset → no Slack integration is constructed.
# Also the last-resort state-signer secret.
# @sensitive
SLACK_APP_SIGNING_SECRET=
# Slack bot token (OAuth & Permissions → Bot User OAuth Token, starts xoxb-).
# @sensitive
SLACK_APP_BOT_TOKEN=
# Slack app OAuth client credentials, for the "Sign in with Slack" (OIDC)
# account-linking flow.
# @public
SLACK_APP_CLIENT_ID=
# @sensitive
SLACK_APP_CLIENT_SECRET=
# Comma-separated origins allowed for credentialed cross-origin requests; only
# needed when the SPA is hosted separately from the API server.
# @public
MASTRACODE_ALLOWED_ORIGINS=
# Explicit path to the built SPA (a dir containing index.html). Checked first;
# then `factory/` under the working directory, `factory/` next to the server
# bundle, `<MASTRA_PROJECT_ROOT>/src/mastra/public/factory`, and
# `src/mastra/public/factory` under the working directory
# (@mastra/factory dist/spa-static.js:56-64).
# @public
MASTRACODE_UI_DIST=

# ---------------------------------------------------------------------------
# Stored credential encryption
# ---------------------------------------------------------------------------

# Required whenever authentication is enabled. Base64-encoded 32-byte AES key
# used to encrypt model-provider keys, custom-provider API keys, GitHub PATs,
# and integration OAuth tokens before they are persisted. Generate with:
#   openssl rand -base64 32
# Keep this stable across deploys; losing it makes stored credentials unreadable.
# @sensitive
FACTORY_CREDENTIAL_ENCRYPTION_KEY=
# Identifier recorded with new ciphertext. Change this when rotating the key.
# @public
FACTORY_CREDENTIAL_ENCRYPTION_KEY_ID=v1
# Optional JSON object mapping previous key ids to base64-encoded 32-byte keys.
# Example: {"v1":"<old-base64-key>"}
# @sensitive
FACTORY_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# Mastra platform auth (highest precedence)
# When MASTRA_SHARED_API_URL is set, this instance defers all identity to a
# Mastra platform API. Takes precedence over WORKOS_* and BETTER_AUTH_SECRET.
# ---------------------------------------------------------------------------

# @public @type=url
MASTRA_SHARED_API_URL=
# Only honored on the platform-deferred auth path.
# @public
MASTRA_ORGANIZATION_ID=
# Only applies to the platform-deferred auth path.
# @public
MASTRA_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Mastra Platform integrations and sandbox
# The platform sandbox is selected when FACTORY_SANDBOX_PROVIDER is unset and
# MASTRA_PLATFORM_ACCESS_TOKEN or MASTRA_PLATFORM_SECRET_KEY is set, together
# with MASTRA_PROJECT_ID and MASTRA_ENVIRONMENT_ID (src/mastra/index.ts:606-608).
# ---------------------------------------------------------------------------

MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PLATFORM_SECRET_KEY=
# @public
MASTRA_PROJECT_ID=
# @public
MASTRA_ENVIRONMENT_ID=
# Optional PlatformSandbox workspace proxy URL. Defaults to the hosted proxy.
# @public @type=url
MASTRA_WORKSPACE_PROXY_URL=
# Which backend the workspace proxy provisions: "railway" or "e2b". Separate
# from FACTORY_SANDBOX_PROVIDER.
# @public
SANDBOX_PROVIDER=
# (Bare true/false are listed alongside the quoted forms because varlock
# coerces unquoted booleans before enum validation.)
# @public @type=enum("", "true", "false", true, false)
MASTRA_PLATFORM_GITHUB_POLLING_ENABLED=
# @public @type=string(matches="^(|[1-9][0-9]*)$")
MASTRA_PLATFORM_GITHUB_POLLING_INTERVAL_MS=
# @public @type=enum("", "true", "false", true, false)
MASTRA_PLATFORM_GITHUB_RECONCILE_ENABLED=

# ---------------------------------------------------------------------------
# WorkOS auth (ranked above Better Auth)
# ---------------------------------------------------------------------------

WORKOS_API_KEY=
# @public
WORKOS_CLIENT_ID=
# Optional — defaults to <MASTRACODE_PUBLIC_URL>/auth/callback.
# @public @type=url
WORKOS_REDIRECT_URI=
# Optional (recommended in prod): 32+ char secret to seal session cookies.
WORKOS_COOKIE_PASSWORD=

# ---------------------------------------------------------------------------
# Better Auth (Samskara's self-hosted sign-in)
# Setting BETTER_AUTH_SECRET selects it. Samskara builds its OWN betterAuth()
# instance (src/mastra/auth/better-auth.ts) so invitation email is possible,
# which means this deployment owns the Better Auth schema
# (docs/operations/better-auth-migrations.md). Mail needs RESEND_API_KEY and
# MAIL_FROM below. Ranked below WorkOS: a configured WORKOS_* pair still wins.
# ---------------------------------------------------------------------------

# Session signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Exactly 1 turns authentication off, and the Factory UI then does not load.
# Leave unset or 0.
# @public
MASTRACODE_AUTH_DISABLED=

# ---------------------------------------------------------------------------
# Outbound mail (Resend). Without BOTH RESEND_API_KEY and MAIL_FROM, password
# reset is not mounted and invitations notify nobody. See
# docs/operations/mail.md.
# ---------------------------------------------------------------------------

# @sensitive
RESEND_API_KEY=
# Verified sender, e.g. "Samskara <noreply@example.com>".
# @public
MAIL_FROM=
# Optional Reply-To.
# @public
MAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Database: libSQL, local file or Turso. Postgres is not wired.
# ---------------------------------------------------------------------------

# Local file path. Set it to an absolute path; unset, the file is the Mastra
# Code CLI's shared <appdata>/mastracode/mastra.db. Not used when
# TURSO_DATABASE_URL is set.
# @public
MASTRA_DB_PATH=
# Overrides the Mastra Code app-data directory.
# @public
MASTRA_APP_DATA_DIR=
# Turso. A libsql:// URL requires its token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional second Turso database for vectors; unset, vectors share the one above.
TURSO_VECTOR_DATABASE_URL=
TURSO_VECTOR_AUTH_TOKEN=
# Ignored: if set, startup logs a warning and nothing else changes
# (src/mastra/index.ts:291-296). Declared only so a stray value is visible.
DATABASE_URL=
APP_DATABASE_URL=

# ---------------------------------------------------------------------------
# GitHub projects. All five of ID, PRIVATE_KEY, CLIENT_ID, CLIENT_SECRET and
# SLUG are required to construct the integration; a partial set leaves GitHub
# disabled (src/mastra/index.ts:188-201). Like the runtime, this schema does not
# reject a partial set. The callback URL is derived from MASTRACODE_PUBLIC_URL
# (/auth/github/callback).
# ---------------------------------------------------------------------------

# @public
GITHUB_APP_ID=
# PEM contents, e.g. "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
# @public
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# @public
GITHUB_APP_SLUG=
# Signs OAuth/install state; without it every webhook delivery is rejected.
GITHUB_APP_WEBHOOK_SECRET=
# Extra bot logins (comma-separated) trusted to trigger review/comment
# notifications, on top of the built-in defaults.
# @public
MASTRACODE_GITHUB_AUTHORIZED_BOTS=
# @public @type=enum("", "true", "false", true, false)
MASTRACODE_GITHUB_RECONCILE_ENABLED=
# @public @type=string(matches="^(|[1-9][0-9]*)$")
MASTRACODE_GITHUB_RECONCILE_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Model providers: not configured here. Factory runs use credentials stored per
# organization or user (Settings → Factory models → Provider access), and never
# fall back to server environment keys (@mastra/factory
# dist/routes/tenant-credentials.js:11).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Linear intake. Built only when BOTH vars are set; one alone leaves Linear
# disabled (src/mastra/index.ts:206-214).
# ---------------------------------------------------------------------------

# @public
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Distributed event bus (optional). Required with more than one server process.
# ---------------------------------------------------------------------------

REDIS_URL=

# ---------------------------------------------------------------------------
# Beads integration (on by default). See docs/operations/beads.md.
# ---------------------------------------------------------------------------

# Unset = on. "0", "false", "off" or "no" (any case) turns it off.
# Any case; varlock does not validate the value, the runtime switch does
# (packages/factory-beads/src/setting.ts).
# @public
BEADS_INTEGRATION=
# Poll interval in ms (default 60000).
# @public
BEADS_POLL_INTERVAL_MS=
# Where the per-repo bd copies live (default <tmpdir>/factory-beads).
# @public
BEADS_CACHE_DIR=
# bd executable (default `bd` on PATH).
# @public
BEADS_BD_PATH=

# ---------------------------------------------------------------------------
# Sandbox provider: local | e2b | platform. Unset: platform, then e2b, then
# local, whichever this machine is configured for (src/mastra/index.ts:621-623).
# An explicit value missing its credentials throws at startup.
# ---------------------------------------------------------------------------

# @public
FACTORY_SANDBOX_PROVIDER=
# @sensitive
E2B_API_KEY=
# Host root for LocalSandbox checkouts (default ~/.mastracode/web/sandboxes).
# @public
MASTRACODE_LOCAL_SANDBOX_ROOT=

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

# Per-replica cap on concurrent Factory background dispatches (default 25).
# @public
MASTRACODE_DISPATCH_MAX_IN_FLIGHT=
