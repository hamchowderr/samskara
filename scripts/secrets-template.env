# Placeholder secrets for Samskara.
#
# Load every key at once, then fill the values in the Infisical web UI:
#
#   infisical secrets folders create --name samskara --env dev
#   infisical secrets set --file scripts/secrets-template.env --path=/samskara --env=dev
#
# See docs/setup/secrets-infisical.md. Do not put real values in this file —
# it is committed to the repository.
#
# This file lists the secret variables only. Non-secret settings belong in .env
# for local development, and in the server's Infisical folder for production,
# where there is no .env (docs/setup/deploy-coolify.md).
#
# DELETE EVERY KEY YOU DO NOT USE. PASTE_ME is a value, and the code treats any
# non-empty value as configured: TURSO_DATABASE_URL=PASTE_ME becomes the
# database URL and the server fails to start; E2B_API_KEY=PASTE_ME selects the
# E2B sandbox; GITHUB_APP_*=PASTE_ME constructs GitHub with an unusable key.

# --- Required -----------------------------------------------------------
# Signs session cookies. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=PASTE_ME

# Encrypts stored model-provider credentials. Generate: openssl rand -base64 32
# Losing this makes every stored credential unreadable.
FACTORY_CREDENTIAL_ENCRYPTION_KEY=PASTE_ME

# Labels the key above so it can be rotated. Any short string.
FACTORY_CREDENTIAL_ENCRYPTION_KEY_ID=v1

# --- Outbound mail (required for a real deployment) ----------------------
# Nothing in the Mastra packages sends email. Without these, Better Auth does
# not mount password reset at all, email verification cannot complete, and an
# invited teammate is never notified. See docs/operations/mail.md.
# Delete if unused: a placeholder reports mail as configured and every send fails.
RESEND_API_KEY=PASTE_ME

# --- Sandbox ------------------------------------------------------------
# Required when FACTORY_SANDBOX_PROVIDER=e2b, which is what production uses.
# Without a provider that isolates execution, agent commands run on the host.
# Delete if unused: a placeholder selects e2b when FACTORY_SANDBOX_PROVIDER is unset.
E2B_API_KEY=PASTE_ME

# --- Database -----------------------------------------------------------
# Samskara runs on libSQL. With no Turso URL it writes a local file, which does
# not survive a container restart and cannot be shared across replicas. Set
# these for anything beyond a single machine.
# Delete both if unused: a placeholder URL is used as the database URL, and the
# server fails to start.
TURSO_DATABASE_URL=PASTE_ME
TURSO_AUTH_TOKEN=PASTE_ME

# Optional: keep embeddings in a separate database. Unset, vectors share the
# database above. Uncomment both and fill them in to use one.
# TURSO_VECTOR_DATABASE_URL=PASTE_ME
# TURSO_VECTOR_AUTH_TOKEN=PASTE_ME

# --- GitHub App ---------------------------------------------------------
# See docs/setup/github-app.md.
GITHUB_APP_ID=PASTE_ME
GITHUB_APP_SLUG=PASTE_ME
GITHUB_APP_CLIENT_ID=PASTE_ME
GITHUB_APP_CLIENT_SECRET=PASTE_ME
GITHUB_APP_PRIVATE_KEY=PASTE_ME
GITHUB_APP_WEBHOOK_SECRET=PASTE_ME

# --- Slack app (optional) -----------------------------------------------
# See docs/setup/slack-app.md. Slack stays disabled unless the signing secret
# is set. Delete these keys if you do not use Slack: a placeholder signing
# secret constructs the Slack integration. Never leave them blank in .env —
# an empty value shadows the injected one.
SLACK_APP_SIGNING_SECRET=PASTE_ME
SLACK_APP_CLIENT_ID=PASTE_ME
SLACK_APP_CLIENT_SECRET=PASTE_ME
SLACK_APP_BOT_TOKEN=PASTE_ME

# --- Linear (optional) --------------------------------------------------
# Both or neither; one alone leaves Linear disabled. Uncomment both to use it.
# LINEAR_CLIENT_ID=PASTE_ME
# LINEAR_CLIENT_SECRET=PASTE_ME
