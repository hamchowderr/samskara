# Rebuilt inside the image.
node_modules
.mastra
.branded-ui

# Never in an image: local data and secrets.
data
.env
.env.*
!.env.example
.infisical.json

# Tooling and output with no runtime use.
.git
.beads
.claude
test-results
playwright-report

# Not read by the build. Excluded so editing them does not invalidate
# `COPY . .` and re-run `npm run build`.
.github
.agents
.codex
.cursor
docs
e2e
tests
/*.md
/db
/db-wal
*.log
