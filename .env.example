# Samskara environment.
# Copy to .env for local development. Most values are optional — features light
# up as their variables are set (see README.md). Secrets belong in Infisical,
# not here (docs/setup/secrets-infisical.md): an entry in .env shadows an
# injected value. `npm run dev` reads .env and .env.local; .env.schema is used
# only by `npm start` (varlock), not by the dev scripts or the Docker image.
#
# A placeholder is a value: the code treats any non-empty value as configured.
# Leave a variable commented out, or delete it, when you do not use it.

# ---------------------------------------------------------------------------
# Browser-facing origin
# ---------------------------------------------------------------------------

# The public origin the browser uses to reach the app. This is the single
# source of truth for ALL OAuth callback URLs:
#   - WorkOS:  <MASTRACODE_PUBLIC_URL>/auth/callback
#   - GitHub:  <MASTRACODE_PUBLIC_URL>/auth/github/callback
#   - Linear:  <MASTRACODE_PUBLIC_URL>/auth/linear/callback
# Defaults to http://localhost:4111 (the Factory server, which also serves
# the UI) when unset. Locally, set it to the tunnel origin
# (docs/setup/tunnel.md), or every link posted into Slack points at localhost.
# Restart the dev server after changing it.
# MASTRACODE_PUBLIC_URL=
# Public origin Slack/channels must reach for OAuth callbacks and deep links.
# Must be publicly routable (e.g. a tunnel). Kept separate from
# MASTRACODE_PUBLIC_URL so auth can run on localhost while Slack still reaches
# this machine via the tunnel. Falls back to MASTRACODE_PUBLIC_URL when unset.
# MASTRACODE_CHANNELS_PUBLIC_URL=
# Port the server listens on (default 4111). Samskara also uses it to build
# invitation links when MASTRACODE_PUBLIC_URL is unset
# (src/mastra/auth/better-auth.ts:110). The Docker image sets PORT=4111.
# PORT=
# Slack request signing secret (Basic Information → App Credentials). This is
# the switch for Slack as a whole: unset → no Slack integration is constructed
# and the Connections page reports Slack as not set up. Also the last-resort
# state-signer secret (see GITHUB_APP_WEBHOOK_SECRET below), so a Slack-only
# deployment has a signer that survives a restart.
# SLACK_APP_SIGNING_SECRET=
# Slack bot token (OAuth & Permissions → Bot User OAuth Token, starts xoxb-).
# Lets the app post messages and open DMs; without it Slack can reach the app
# but the app cannot answer.
# SLACK_APP_BOT_TOKEN=
# Slack app OAuth client credentials (Basic Information → App Credentials).
# Enable the web-initiated "Sign in with Slack" (OIDC) account-linking flow;
# unset → linking only starts from the Slack-side Connect card. The Slack app
# must list MASTRACODE_CHANNELS_PUBLIC_URL + /connect/slack/oidc/callback as an
# OAuth redirect URL (Slack requires HTTPS, so locally that's the tunnel).
# SLACK_APP_CLIENT_ID=
# SLACK_APP_CLIENT_SECRET=
# Comma-separated origins allowed for credentialed cross-origin requests; only
# needed when the SPA is hosted separately from the API server.
# MASTRACODE_ALLOWED_ORIGINS=
# Explicit path to the built SPA (a dir containing index.html). The server
# looks, in order (@mastra/factory dist/spa-static.js:56-64): this variable,
# `factory/` under the working directory, `factory/` next to the server
# bundle, `<MASTRA_PROJECT_ROOT>/src/mastra/public/factory`, then
# `src/mastra/public/factory` under the working directory. Unset, the
# Factory serves the UI the mastra CLI ships, unmodified.
# MASTRACODE_UI_DIST=

# ---------------------------------------------------------------------------
# Stored credential encryption
# ---------------------------------------------------------------------------

# Required whenever authentication is enabled. Base64-encoded 32-byte AES key
# used to encrypt model-provider keys, custom-provider API keys, GitHub PATs,
# and integration OAuth tokens before they are persisted. Generate with:
#   openssl rand -base64 32
# Keep this stable across deploys; losing it makes stored credentials unreadable.
# `npm run dev` generates a development key into .env.local on first run.
# FACTORY_CREDENTIAL_ENCRYPTION_KEY=
# Identifier recorded with new ciphertext. Change this when rotating the key.
FACTORY_CREDENTIAL_ENCRYPTION_KEY_ID=v1
# Optional JSON object mapping previous key ids to base64-encoded 32-byte keys.
# Keep old keys here during rotation; rows are re-encrypted with the primary key
# when read or when storage initializes. Example: {"v1":"<old-base64-key>"}
# FACTORY_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# Mastra platform auth (highest precedence)
# When MASTRA_SHARED_API_URL is set, this instance defers all identity to a
# Mastra platform API (e.g. https://platform.mastra.ai/v1). No WorkOS/better-auth
# secrets are needed here — the platform owns them. Takes precedence over
# WORKOS_* and BETTER_AUTH_SECRET below, so a deployment that sets this var
# never falls back to its own credentials by accident.
# ---------------------------------------------------------------------------

# Base URL of the Mastra platform API's `/v1` root (e.g.
# https://platform.mastra.ai/v1 or http://localhost:3010/v1 for local dev
# against a locally-running platform API). Also used by zero-argument
# PlatformGithubIntegration and PlatformLinearIntegration.
# MASTRA_SHARED_API_URL=
# Optional: pin this deployment to a specific WorkOS organization. Members
# are served in this org whatever org their session cookie is on; users whose
# memberships don't include it are rejected. Leave unset for
# multi-org deployments. Only honored on the platform-deferred auth path;
# the self-managed WORKOS_* path below does not enforce it.
# MASTRA_ORGANIZATION_ID=
# Optional: parent cookie domain (e.g. `.mastra.cloud`) for the sealed
# session cookie this deployment sets after callback. Auto-detected from
# MASTRA_SHARED_API_URL for `*.mastra.ai` hosts; otherwise the cookie is
# host-only (fine for localhost dev on different ports). Only applies to the
# platform-deferred auth path, not the self-managed WORKOS_* path below.
# MASTRA_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Mastra Platform integrations and sandbox
# PlatformGithubIntegration and PlatformLinearIntegration are zero-argument
# integrations. They use MASTRA_SHARED_API_URL and a Platform credential:
# MASTRA_PLATFORM_ACCESS_TOKEN (checked first) or MASTRA_PLATFORM_SECRET_KEY.
# Samskara selects the platform sandbox when FACTORY_SANDBOX_PROVIDER is
# unset and MASTRA_PLATFORM_ACCESS_TOKEN or MASTRA_PLATFORM_SECRET_KEY is set,
# together with MASTRA_PROJECT_ID and MASTRA_ENVIRONMENT_ID
# (src/mastra/index.ts:606-608).
# ---------------------------------------------------------------------------

# Credential Mastra Platform injects into deployed projects; locally set your
# platform org key here.
# MASTRA_PLATFORM_ACCESS_TOKEN=
# Org secret key written by project scaffolding. Used by the Platform
# integrations when MASTRA_PLATFORM_ACCESS_TOKEN is unset. Either key, with
# the two ids below, also satisfies the platform sandbox.
# MASTRA_PLATFORM_SECRET_KEY=
# Required for the platform sandbox.
# MASTRA_PROJECT_ID=
# Required for the platform sandbox.
# MASTRA_ENVIRONMENT_ID=
# Optional PlatformSandbox workspace proxy URL. Defaults to the hosted proxy.
# MASTRA_WORKSPACE_PROXY_URL=
# Which sandbox backend the workspace proxy should provision: "railway" or
# "e2b". Unset keeps the proxy's legacy (Railway) routes. Separate from
# FACTORY_SANDBOX_PROVIDER below.
# SANDBOX_PROVIDER=
# GitHub event polling is enabled by default. Set false to disable it.
# MASTRA_PLATFORM_GITHUB_POLLING_ENABLED=
# Optional positive polling interval in milliseconds. Defaults to 5000.
# MASTRA_PLATFORM_GITHUB_POLLING_INTERVAL_MS=
# Merged-PR reconcile sweep is enabled by default (runs even when event
# polling is disabled). Set false to disable it.
# MASTRA_PLATFORM_GITHUB_RECONCILE_ENABLED=

# ---------------------------------------------------------------------------
# WorkOS auth
# When WORKOS_API_KEY and WORKOS_CLIENT_ID are set, every route requires a
# signed-in user (hosted login + encrypted session). Ranked above Better Auth.
# ---------------------------------------------------------------------------

# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# Optional — defaults to <MASTRACODE_PUBLIC_URL>/auth/callback. Must match an
# allowed redirect URI in the WorkOS dashboard.
# WORKOS_REDIRECT_URI=
# Optional (recommended in prod): 32+ char secret to seal session cookies.
# WORKOS_COOKIE_PASSWORD=

# ---------------------------------------------------------------------------
# Self-hosted sign-in (Better Auth)
# The path Samskara actually runs: no WorkOS tenant, no platform identity.
# Setting BETTER_AUTH_SECRET selects it. Unlike the provider's built-in
# "deferred instance" mode, this deployment builds its OWN betterAuth()
# instance (src/mastra/auth/better-auth.ts) so invitation email is possible —
# which also means this deployment owns the Better Auth schema. See
# docs/operations/better-auth-migrations.md.
# ---------------------------------------------------------------------------

# Session signing secret. Generate with `openssl rand -base64 32`.
# `npm run dev` generates a development secret into .env.local on first run.
# BETTER_AUTH_SECRET=
# Set to exactly 1 to turn authentication off entirely. Do not: the Factory
# UI and its /web/factory routes need a signed-in user with an organization,
# so the UI does not load. `npm run dev` pins it to 0, because
# `mastra factory dev` would otherwise turn auth off.
# MASTRACODE_AUTH_DISABLED=

# ---------------------------------------------------------------------------
# Outbound mail (Resend)
# Nothing in @mastra/factory, @mastra/code-sdk or @mastra/auth-better-auth
# sends email — self-hosting owns delivery. Without BOTH RESEND_API_KEY and
# MAIL_FROM, Better Auth does not mount password reset at all, email
# verification cannot complete, and invite-member writes a row that notifies
# nobody. The API key is a secret: keep it in Infisical at /samskara, never
# here. See docs/operations/mail.md.
# ---------------------------------------------------------------------------

# RESEND_API_KEY=
# Sender address. NOT a secret, so it belongs here rather than in the secret
# store — but the domain must be verified in the Resend account or every send
# is rejected. This is Samskara's own sender; edit it for your own domain.
MAIL_FROM=Samskara <noreply@send.otakusolutions.io>
# Optional Reply-To for auth email.
# MAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Database: libSQL, local file or Turso
# One libSQL database holds agent state and the Factory app tables, and a
# second holds recall vectors. Postgres is deliberately not wired.
# ---------------------------------------------------------------------------

# Local development: SET THIS, to an absolute path inside this repository,
# and create the directory first (libSQL does not create it). For example:
#   MASTRA_DB_PATH=C:/path/to/samskara/data/samskara.db
#   MASTRA_DB_PATH=/path/to/samskara/data/samskara.db
# The vector file is derived from it: data/samskara-vectors.db.
# Why absolute: `mastra factory dev` runs the server with src/mastra/public as
# its working directory, so a relative path lands inside the dev watch tree.
# Why set it at all: unset, the app database is the Mastra Code CLI's own
# <appdata>/mastracode/mastra.db (@mastra/code-sdk dist/utils/project.js:150-153)
# and the derived vector path is the CLI's mastra-vectors.db, so running both
# yields `SQLITE_BUSY: database is locked`. `npm run db:backup` also needs it.
# MASTRA_DB_PATH=
# Overrides the Mastra Code app-data directory itself (where mastra.db and
# other SDK files default to). Not needed when MASTRA_DB_PATH is set.
# MASTRA_APP_DATA_DIR=

# Production: Turso. With TURSO_DATABASE_URL set, MASTRA_DB_PATH is not used.
# A libsql:// URL requires its token. Keep all four in Infisical.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# Optional: a second Turso database for vectors. Unset, vectors share the
# database above, and the [storage] boot line says "(shared)".
# TURSO_VECTOR_DATABASE_URL=
# TURSO_VECTOR_AUTH_TOKEN=

# DATABASE_URL and APP_DATABASE_URL are ignored: if either is set, startup logs
# a warning and nothing else changes (src/mastra/index.ts:291-296).

# ---------------------------------------------------------------------------
# GitHub projects
# When all five required GitHub App variables are set (ID, PRIVATE_KEY,
# CLIENT_ID, CLIENT_SECRET, SLUG), signed-in users can install the GitHub App,
# pick repositories, and link each one to a factory. A partial set leaves the
# integration off. See docs/setup/github-app.md.
#
# The GitHub callback URL is always derived from MASTRACODE_PUBLIC_URL
# (/auth/github/callback) — there is no separate redirect env var. Register
# this exact URL in both the GitHub App's "Callback URL" and "Setup URL"
# fields (Settings → GitHub Apps → your app → General).
# ---------------------------------------------------------------------------

# GITHUB_APP_ID=
# PEM contents, e.g. "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# Stable secret for signing GitHub OAuth/install state and verifying webhooks.
# Not required to construct the integration, but without it every webhook
# delivery is rejected with 401 (@mastra/factory
# dist/integrations/github/webhook.js:27-34), and, unless WORKOS_COOKIE_PASSWORD
# or SLACK_APP_SIGNING_SECRET is set, the state signer is a per-process random
# secret.
# GITHUB_APP_WEBHOOK_SECRET=
# Extra bot logins, comma-separated, whose reviews and comments may trigger
# review/comment notifications, on top of the built-in coderabbitai[bot] and
# devin-ai-integration[bot] (@mastra/factory dist/integrations/github/webhook.js:242-250).
# MASTRACODE_GITHUB_AUTHORIZED_BOTS=
# Merged-PR reconcile sweep is enabled by default. It is the only writer of
# merge state when GitHub cannot reach this deployment's webhook endpoint
# (private network, local dev). Set false to disable it.
# MASTRACODE_GITHUB_RECONCILE_ENABLED=
# Optional positive sweep interval in milliseconds. Defaults to 300000 (5min).
# MASTRACODE_GITHUB_RECONCILE_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Model providers
# Not set here. Factory runs use credentials stored per organization or user,
# added in the Factory under the factory's Settings → Factory models →
# Provider access → Connect with API key. Tenant runs never fall back to
# server environment keys (@mastra/factory dist/routes/tenant-credentials.js:11),
# so ANTHROPIC_API_KEY / OPENAI_API_KEY here do not reach them.
# See docs/setup/new-project.md.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Linear intake
# Built only when BOTH Linear OAuth vars are set (src/mastra/index.ts:206-214).
# Setting only one leaves Linear disabled; it is not a boot error.
#
# The Linear OAuth callback URL is derived from MASTRACODE_PUBLIC_URL
# (/auth/linear/callback) — register that exact URL in the Linear OAuth app.
# ---------------------------------------------------------------------------

# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Distributed event bus (optional)
# When set, events (streams, workflows, signals) ride Redis Streams so
# multiple web server processes share one event bus, and leases (including
# the beads writer lease) are shared across them. Unset for a single process.
# ---------------------------------------------------------------------------

# REDIS_URL=

# ---------------------------------------------------------------------------
# Beads integration (on by default)
# Ready beads (bd) in each linked GitHub repository become Work cards; a card
# reaching Done closes its bead and publishes it to refs/dolt/data. Needs the
# GitHub App (with contents:write) and the `bd` binary on the host; without
# either, startup logs one line and the integration does nothing. A linked repo
# with no refs/dolt/data is reported as no-beads-data, not as an error. With
# more than one server process, REDIS_URL must be set (single-writer lease).
# Never link one repository in two deployments (local and production): see
# docs/setup/environments.md. See docs/operations/beads.md.
# ---------------------------------------------------------------------------

# Unset = on. "0", "false", "off" or "no" (any case) turns it off.
# BEADS_INTEGRATION=
# Poll interval in ms (default 60000).
# BEADS_POLL_INTERVAL_MS=
# Where the per-repo bd copies live (default <tmpdir>/factory-beads). Keep it
# short on Windows.
# BEADS_CACHE_DIR=
# bd executable (default `bd` on PATH).
# BEADS_BD_PATH=

# ---------------------------------------------------------------------------
# Sandbox provider
# Where agent commands run against a repository checkout. One of:
#   local    — directly on this machine, with this process's privileges.
#              Confined only by seatbelt (macOS) or bwrap (Linux, when
#              installed); Windows has no backend. Never serve clients this way.
#   e2b      — a per-session E2B microVM. What Samskara serves clients with.
#              Needs E2B_API_KEY.
#   platform — Mastra's managed platform workspace. Needs the platform
#              credentials above.
# Unset: the most isolated provider this machine is configured for — platform,
# then e2b, then local (src/mastra/index.ts:621-623). An explicit value whose
# credentials are missing THROWS at startup; it never falls back to another
# provider.
# ---------------------------------------------------------------------------

# FACTORY_SANDBOX_PROVIDER=
# E2B API key (a secret: keep it in Infisical). Setting it also makes e2b the
# automatic choice when FACTORY_SANDBOX_PROVIDER is unset.
# E2B_API_KEY=
# Host root for LocalSandbox checkouts (default ~/.mastracode/web/sandboxes);
# only used by the local provider.
# MASTRACODE_LOCAL_SANDBOX_ROOT=

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

# Per-replica cap on concurrent Factory background dispatches (runs started by
# board rules). Unset, or not a positive integer, means the dispatcher default
# of 25 (@mastra/factory dist/rules/dispatcher.js:25).
# MASTRACODE_DISPATCH_MAX_IN_FLIGHT=
