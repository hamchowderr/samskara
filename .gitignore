node_modules/
.env
.env.local
.mastra/

# Runtime database — lives OUTSIDE .mastra/ because mastra build wipes that folder
data/
backups/
dist/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
.env.*
!.env.example
!.env.schema
*.log
.DS_Store

# Rendered from scripts/slack-app-manifest.template.json — holds one deployment's hostname
scripts/slack-app-manifest.json

# Beads: the Dolt DB is the source of truth; these are disposable local exports
.beads/issues.jsonl
.beads/cc-task-map.json

# Built Factory web UI — regenerated by the mastra CLI, served from here at runtime
src/mastra/public/factory/

# Agent-tool symlinks — absolute paths, regenerated by `npx skills add`
.claude/skills/

# Mastra skills — fetched from mastra-ai/skills, pinned by skills-lock.json
.agents/skills/mastra/
.agents/skills/mastra-factory/
