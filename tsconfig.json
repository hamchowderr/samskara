{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@samskara/factory-beads": ["./packages/factory-beads/src/index.ts"]
    },
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "tests/**/*",
    "vitest.config.ts",
    "e2e/**/*",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
