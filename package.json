{
  "name": "samskara",
  "version": "0.1.0",
  "description": "Samskara — a self-hosted Mastra Factory. Agent-driven software delivery with chat-submitted client work as a first-class intake path.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "cross-env MASTRACODE_AUTH_DISABLED=0 mastra factory dev --dir src/mastra",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "check": "tsc --noEmit",
    "build": "mastra build --dir src/mastra",
    "start": "varlock run -- mastra start",
    "deploy": "mastra deploy",
    "dev:secure": "infisical run --projectId <project-id> --env dev --path=/samskara --silent -- cross-env MASTRACODE_AUTH_DISABLED=0 mastra factory dev --dir src/mastra",
    "start:secure": "infisical run --projectId <project-id> --env dev --path=/samskara --silent -- mastra start"
  },
  "dependencies": {
    "@mastra/auth-better-auth": "1.1.5",
    "@mastra/auth-workos": "1.6.5",
    "@mastra/code-sdk": "1.7.2",
    "@mastra/core": "1.67.0",
    "@mastra/e2b": "0.12.0",
    "@mastra/factory": "0.15.0",
    "@mastra/libsql": "1.23.0",
    "@mastra/memory": "1.30.0",
    "@mastra/pg": "1.25.0",
    "@mastra/platform-workspace": "1.6.1",
    "@mastra/redis-streams": "0.4.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "cross-env": "10.1.0",
    "mastra": "1.30.0",
    "typescript": "^5.9.2",
    "varlock": "^1.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
