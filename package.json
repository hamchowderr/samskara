{
  "name": "samskara",
  "version": "0.1.0",
  "description": "Samskara — a self-hosted Mastra Factory. Agent-driven software delivery with chat-submitted client work as a first-class intake path.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/ensure-dev-secrets.mjs",
    "dev": "cross-env MASTRACODE_AUTH_DISABLED=0 mastra factory dev --dir src/mastra",
    "check": "tsc --noEmit",
    "build": "mastra build --dir src/mastra",
    "start": "varlock run -- mastra start",
    "deploy": "mastra deploy",
    "predev:secure": "infisical run --env dev --path=/samskara --silent -- node scripts/check-dev-keys.mjs",
    "dev:secure": "infisical run --env dev --path=/samskara --silent -- cross-env MASTRACODE_AUTH_DISABLED=0 mastra factory dev --dir src/mastra",
    "start:secure": "infisical run --env dev --path=/samskara --silent -- mastra start",
    "db:backup": "node scripts/backup-db.mjs",
    "check:auth-parity": "node scripts/check-auth-provider-parity.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@libsql/kysely-libsql": "0.4.1",
    "@mastra/auth-better-auth": "1.1.5",
    "@mastra/auth-workos": "1.6.6",
    "@mastra/code-sdk": "1.13.0",
    "@mastra/core": "1.77.0",
    "@mastra/docker": "0.11.0",
    "@mastra/e2b": "0.14.0",
    "@mastra/factory": "0.22.0",
    "@mastra/libsql": "1.26.1",
    "@mastra/memory": "1.37.1",
    "@mastra/platform-workspace": "1.8.0",
    "@mastra/redis-streams": "0.4.3",
    "@samskara/factory-beads": "0.1.0",
    "better-auth": "1.7.5",
    "resend": "6.28.1",
    "undici": "7.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "@mastra/mcp-docs-server": "^1.2.26",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "cross-env": "10.1.0",
    "mastra": "1.34.0",
    "typescript": "^5.9.2",
    "varlock": "^1.9.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
